rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOf(gameId) {
      return isSignedIn() && exists(/databases/$(database)/documents/games/$(gameId)/members/$(request.auth.uid));
    }

    function isHostOf(gameId) {
      return isSignedIn() && get(/databases/$(database)/documents/games/$(gameId)).data.hostUid == request.auth.uid;
    }

    // Games collection
    match /games/{gameId} {
      // Data reading is strictly bounded to members and host of the room
      // Prospective members use the secure /api/rooms/lookup endpoint
      allow read: if isMemberOf(gameId) || isHostOf(gameId);

      // Room creation by authenticated host
      allow create: if isSignedIn() 
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.initialBalanceDistributed == false;

      // Direct client updates are blocked; mutations are handled via server.ts
      allow update: if false;
      allow delete: if false;

      // Members subcollection: only room members/host can read
      match /members/{memberUid} {
        allow read: if isMemberOf(gameId) || isHostOf(gameId);
        // Direct client member modifications, balance edits, or deletions are forbidden
        allow write: if false;
      }

      // Assets catalog: only room members/host can read
      match /assets/{assetId} {
        allow read: if isMemberOf(gameId) || isHostOf(gameId);
        // Asset creation only during room initialization by host
        allow create: if isSignedIn() && isHostOf(gameId);
        // Direct client ownership/mortgage modifications are blocked
        allow update: if false;
        allow delete: if false;
      }

      // Append-only ledger transactions: only room members/host can read
      match /transactions/{txId} {
        allow read: if isMemberOf(gameId) || isHostOf(gameId);
        // Clients can NEVER create, edit, or delete financial records directly
        allow write: if false;
      }

      // Consensus approval requests: only room members/host can read
      match /requests/{requestId} {
        allow read: if isMemberOf(gameId) || isHostOf(gameId);
        // All request submissions and voting are executed through trusted backend server
        allow write: if false;
      }
    }
  }
}
